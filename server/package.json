{
  "name": "@fakeradio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @fakeradio/shared build",
    "dev": "tsx src/index.ts",
    "prebuild": "pnpm --filter @fakeradio/shared build",
    "build": "tsc -b tsconfig.json --force",
    "pretypecheck": "pnpm --filter @fakeradio/shared build",
    "typecheck": "tsc -b tsconfig.json --force",
    "pretest": "pnpm --filter @fakeradio/shared build",
    "test": "cd .. && vitest run server/src",
    "prelint": "pnpm --filter @fakeradio/shared build",
    "lint": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@fakeradio/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^17.2.3",
    "edge-tts": "^1.0.1",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
